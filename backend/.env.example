NODE_ENV=
PORT=
DATABASE_URL=
DATABASE_PASSWORD=
RHC_ID=
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PROTOCOL_FEE_WALLET=
FRONTEND_URL=
# Server-only Resend credentials for wallet-verified liquidation email alerts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@updates.floatsheets.app
# Must match FLOATSHEETS_SERVER_API_SECRET in the frontend deployment.
SERVER_API_SHARED_SECRET=
ADMIN_EOA_ADDRESS=
FLOAT_ORACLE_ADDRESS=
FLOAT_VAULT_ADDRESS=
FLOAT_CLEARING_HOUSE_ADDRESS=
# Optional explicit legacy pair. If unset, FLOAT_* above are used for Legacy Orion.
LEGACY_ORION_FLOAT_ORACLE_ADDRESS=
LEGACY_ORION_FLOAT_VAULT_ADDRESS=
LEGACY_ORION_FLOAT_CLEARING_HOUSE_ADDRESS=
# Silverlake is the dashboard default. Keep Amber populated for retired-version history.
SILVERLAKE_FLOAT_ORACLE_ADDRESS=0xf935b2439E4B74F9Bd100148e4eFe3dE94DEF315
SILVERLAKE_FLOAT_VAULT_ADDRESS=0x9DA17d606453552bc7CD54f4d44813C8Acff55c4
SILVERLAKE_FLOAT_CLEARING_HOUSE_ADDRESS=0xC197d8F546CC56A4148b30A74d3A2c5975255C6A
AMBER_FLOAT_ORACLE_ADDRESS=0x71B5FBd2df7eF976d02A4b4090450EEE24F77Ce0
AMBER_FLOAT_VAULT_ADDRESS=0xD5B0461F09C0Cb67AEd9Ca8e73569EAfa3a2E445
AMBER_FLOAT_CLEARING_HOUSE_ADDRESS=0x022Cc8DFf79414DcB56812Bd93601854E2b7A700
# Jasper remains visible as a retired, non-selectable version.
JASPER_FLOAT_ORACLE_ADDRESS=0x2C21CEe824Ed6BD4380F60a610F179f2f7b555E0
JASPER_FLOAT_VAULT_ADDRESS=0xAAd35a630D6bFDBd1b46495721e9C6979844F960
JASPER_FLOAT_CLEARING_HOUSE_ADDRESS=0x82889877B395840BC0efce625C06c5423C75B029
# Meadow remains selectable in API clients but is paused in the dashboard.
MEADOW_FLOAT_ORACLE_ADDRESS=0x7Fda40E8FD27cA067C9Ee23EA0Fd0cb8Bb786A8a
MEADOW_FLOAT_VAULT_ADDRESS=0xb74eD266A95d8393cDaF2Fa6cADd98b5a1D91875
MEADOW_FLOAT_CLEARING_HOUSE_ADDRESS=0xc1AfA648C30090Aa8fDd3fbca384bd65b52B58Dd
MASTER_ADMIN_KEY=
USDG_ADDRESS=
ORACLE_SIGNER_PRIVATE_KEY=
ORACLE_SIGNER_ADDRESS=
MARKET_POLL_INTERVAL_MS=
UNISWAP_TWAP_WINDOW_SECONDS=
ORACLE_PRICE_MAX_AGE_SECONDS=
ORACLE_PUBLISHER_PRIVATE_KEY=
ORACLE_PUBLISHER_ADDRESS=
ORACLE_PUBLISH_INTERVAL_SECONDS=90
# Recommended: 105. This stays 15 seconds inside the deployed clearing
# house's 120-second oracle freshness window.
QUOTE_TTL_SECONDS=105
QUOTE_SIGNER_PRIVATE_KEY=
QUOTE_SIGNER_ADDRESS=
# Exchange halt mirror: halted underlyings become close-only.
HALT_FEED_ENABLED=true
HALT_POLL_INTERVAL_SECONDS=60
# Position keeper: closes positions below maintenance margin or past 7 days.
KEEPER_ENABLED=true
KEEPER_INTERVAL_SECONDS=30
# Optional dedicated keeper wallet (needs Robinhood Chain ETH for gas).
# Defaults to ORACLE_PUBLISHER_PRIVATE_KEY when unset.
KEEPER_PRIVATE_KEY=
LOG_LEVEL=
